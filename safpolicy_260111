function calculate_emission_changes(solutions, params)
    AVIATION_FUELS = [:jet_fuel, :saf_atj_conv, :saf_atj_cs,
        :saf_hefa_conv, :saf_hefa_cs, :saf_hefa_nonsoy]
    ROAD_FUELS = [:gasoline, :ethanol, :diesel, :biodiesel_soy, :biodiesel_nonsoy,
        :rd_soy, :rd_nonsoy]
    FOOD_GOODS = [:corn, :soyoil]  # all food goods

    delta = params.coeff.delta

    # Calculate emissions for each scenario by sector
    emissions = Dict()
    for scenario in SCENARIOS
        sol = solutions[scenario]

        avi_emission = sum(delta[g] * value(sol[:q][g]) for g in AVIATION_FUELS)
        road_emission = sum(delta[g] * value(sol[:q][g]) for g in ROAD_FUELS)
        food_emission = sum(delta[g] * value(sol[:x][g]) for g in FOOD_GOODS)
        total_emission = avi_emission + road_emission + food_emission

        emissions[scenario] = Dict(
            :aviation => avi_emission,
            :road => road_emission,
            :food => food_emission,
            :total => total_emission
        )
    end

    return emissions
end

