function calculate_land_use(results, params)  # solutions -> results로 변경
    gamma = params.coeff.gamma
    omega = params.coeff.omega

    land_use = Dict()
    for scenario in SCENARIOS
        model = results[scenario]  # 이제 model 객체를 가져옴

        # Direct land use from model variables
        l_n = value(model[:l_n])
        l_cs = value(model[:l_cs])

        # Conventional land breakdown
        corn_land_n = omega * l_n
        soy_land_n = (1 - omega) * l_n

        # Climate-smart land breakdown
        corn_land_cs = omega * l_cs
        soy_land_cs = (1 - omega) * l_cs

        # Total by crop type
        total_corn_land = corn_land_n + corn_land_cs
        total_soy_land = soy_land_n + soy_land_cs

        # Total by practice type
        total_conventional = l_n
        total_climate_smart = l_cs

        # Grand total
        total_land = l_n + l_cs

        land_use[scenario] = Dict(
            :corn_conventional => 1000 * corn_land_n,
            :corn_climate_smart => 1000 * corn_land_cs,
            :corn_total => 1000 * total_corn_land,
            :soy_conventional => 1000 * soy_land_n,
            :soy_climate_smart => 1000 * soy_land_cs,
            :soy_total => 1000 * total_soy_land,
            :conventional_total => 1000 * total_conventional,
            :climate_smart_total => 1000 * total_climate_smart,
            :total => 1000 * total_land
        )
    end
    return land_use
end

